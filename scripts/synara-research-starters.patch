+
+export type ResearchLanding = { stage: string | null; status: string; detail: string; completedPasses: number };
+
+export const RESEARCH_STARTERS = {
+  start: { title: "researchStartAction", prompt: "researchStartPrompt", icon: "polish" },
+  continue: { title: "researchContinueAction", prompt: "researchContinuePrompt", icon: "revise" },
+  prior: { title: "researchPriorAction", prompt: "researchPriorPrompt", icon: "references" },
+  gaps: { title: "researchGapsAction", prompt: "researchGapsPrompt", icon: "references" },
+  design: { title: "researchDesignAction", prompt: "researchDesignPrompt", icon: "revise" },
+  findings: { title: "researchFindingsAction", prompt: "researchFindingsPrompt", icon: "proofread" },
+} as const satisfies Record<string, { title: string; prompt: string; icon: LatticeStarterKind }>;
+
+type ResearchStarter = keyof typeof RESEARCH_STARTERS;
+
+export function researchStarterKinds(research: ResearchLanding): ResearchStarter[] {
+  const { stage, completedPasses } = research;
+  if (!stage) return ["start"];
+  if (stage === "analysis" || stage === "reporting" || (stage === "experiments" && research.status === "complete")) return ["continue", "findings", "gaps"];
+  if (stage === "ready" || stage === "setup" || stage === "experiments") return ["continue", "gaps", "design"];
+  return completedPasses > 0 ? ["continue", "gaps", "prior"] : ["continue", "prior"];
+}
+
+export function readResearchLandingMessage(event: MessageEvent, config: EmbedModeConfig): ResearchLanding | null | undefined {
+  if (
+    event.source !== window.parent || event.origin !== config.hostOrigin ||
+    event.data?.type !== "lattice:research-starters" ||
+    !embedWorkspaceMatches(config, event.data.workspaceRoot)
+  ) return undefined;
+  const value = event.data.research;
+  if (value === null) return null;
+  if (
+    !value || typeof value !== "object" ||
+    (value.stage !== null && typeof value.stage !== "string") ||
+    typeof value.status !== "string" ||
+    typeof value.detail !== "string" || value.detail.length > 500 ||
+    !Number.isInteger(value.completedPasses) || value.completedPasses < 0
+  ) return undefined;
+  return { stage: value.stage, status: value.status, detail: value.detail, completedPasses: value.completedPasses };
+}
 
